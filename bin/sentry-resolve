#!/usr/bin/env python3
"""
Mark a Sentry issue as resolved.

Usage:
  sentry-resolve <issue_id>     Resolve the issue (needs event:write scope)

Config is read from .claude/sentry.json (project, preferred) then
~/.claude/sentry.json (global fallback). Format:
  { "org": "your-sentry-org-slug", "token": "sntrys_..." }

The token must have the `event:write` scope (in addition to `event:read`
used by sentry-fetch). Update it at Sentry > Settings > Auth Tokens.

Exit codes:
  0  success
  1  network / API / JSON-parse error
  2  usage error
  3  no config file found (neither project nor global)
  4  config found but placeholder values (edit the file)
  5  forbidden — token is missing the event:write scope
"""
import json
import sys
import urllib.error
import urllib.request
from pathlib import Path


def die(msg, code=1):
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def usage(code=2):
    print(__doc__.strip(), file=sys.stderr)
    sys.exit(code)


def project_cfg_path():
    return Path(".claude/sentry.json")


def global_cfg_path():
    return Path.home() / ".claude" / "sentry.json"


def is_placeholder(token: str) -> bool:
    if not token:
        return True
    if token.startswith("<") or token.endswith(">"):
        return True
    if token in ("sntrys_...", "REPLACE_ME", "TODO"):
        return True
    return False


def load_config():
    for path in (project_cfg_path(), global_cfg_path()):
        if path.exists():
            try:
                return path, json.loads(path.read_text())
            except json.JSONDecodeError as e:
                die(f"{path} is not valid JSON: {e}")
    return None, None


def resolve_issue(cfg, issue):
    org = (cfg.get("org") or "").strip()
    token = (cfg.get("token") or "").strip()
    if not org or is_placeholder(token):
        return None

    url = f"https://sentry.io/api/0/organizations/{org}/issues/{issue}/"
    body = json.dumps({"status": "resolved"}).encode()
    req = urllib.request.Request(
        url,
        data=body,
        method="PUT",
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
    )

    try:
        with urllib.request.urlopen(req) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        if e.code == 403:
            die(
                "Sentry returned 403 — the auth token is missing the "
                "`event:write` scope. Edit the token at "
                "Sentry > Settings > Auth Tokens and re-run.",
                code=5,
            )
        if e.code == 404:
            die(f"Sentry issue {issue!r} not found.", code=1)
        die(f"Sentry API returned {e.code} {e.reason} for issue {issue!r}")
    except urllib.error.URLError as e:
        die(f"Network error contacting Sentry: {e.reason}")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        if not args:
            usage()
        print(__doc__.strip())
        sys.exit(0)
    if len(args) != 1 or args[0].startswith("--"):
        usage()

    issue = args[0]

    cfg_path, cfg = load_config()
    if cfg is None:
        die(
            "No Sentry config found. Run `sentry-fetch --init-project` "
            "(this project only) or `sentry-fetch --init-global` (all projects) "
            "to create a stub config file.",
            code=3,
        )

    result = resolve_issue(cfg, issue)
    if result is None:
        die(
            f"{cfg_path} is missing a real org slug or token (placeholder detected). "
            f"Edit the file and re-run.",
            code=4,
        )

    status = result.get("status", "<unknown>")
    title = (result.get("title") or "").split("\n")[0][:80]
    permalink = result.get("permalink", "")
    print(f"Resolved Sentry issue {issue}:")
    print(f"  status: {status}")
    print(f"  title:  {title}")
    if permalink:
        print(f"  url:    {permalink}")


if __name__ == "__main__":
    main()
